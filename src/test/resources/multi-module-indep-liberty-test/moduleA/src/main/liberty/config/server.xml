<server description="Module A Liberty server">

    <featureManager>
        <feature>servlet-4.0</feature>
    </featureManager>

    <variable name="http.port" defaultValue="9088" />
    <variable name="https.port" defaultValue="9451" />

    <httpEndpoint host="*" httpPort="${http.port}"
        httpsPort="${https.port}" id="defaultHttpEndpoint" />

    <webApplication id="moduleA-1.0-SNAPSHOT"
                    location="moduleA-1.0-SNAPSHOT.war"
                    name="moduleA-1.0-SNAPSHOT" />
</server>
