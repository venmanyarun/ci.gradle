CONFIG_SERVER_ENV=TEST
TEST_PROP_2=green
TEST_PROP_3=blue

EXP_VAR=TEST
EXP_VAR2=UNIX
EXP_VAR3=WINDOWS
TEST_EXP_VAR_UNIX=${EXP_VAR}_${EXP_VAR2}
TEST_EXP_VAR_WIN=!EXP_VAR!_!EXP_VAR3!
# Windows-style path: backslashes must be preserved as-is when mergeServerEnv=true
WIN_HOME=C:\myfolder\folder2
# Delayed-expansion variable reference: must not have backslash mangled to forward-slash
WIN_JAVA_HOME=!WIN_HOME!\java
# Forward-slash path: must remain unchanged on all platforms
UNIX_HOME=/usr/local/myapp
# Arbitrary value containing a backslash (not a path): must be preserved verbatim
TEST_BACKSLASH_VALUE=abc\`;xyz